# Meta Lingua Platform Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
NODE_ENV=production
PORT=5000
# All three vars below MUST be set to the same value — your public-facing domain.
# APP_URL is used by docker-compose; BASE_URL is the Shetab callback fallback;
# FRONTEND_URL is used for payment success/failure redirects.
APP_URL=https://yourdomain.com
BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://metalingua:your_password@localhost:5432/metalingua
DB_NAME=metalingua
DB_USER=metalingua
DB_PASSWORD=changeme_strong_password

# Redis Configuration
# When running via Docker Compose, REDIS_HOST should be "redis" (service name).
# The queue worker reads REDIS_HOST/REDIS_PORT/REDIS_PASSWORD individually.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Full URL — set this only if you use a managed Redis (e.g. Redis Cloud)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate strong random strings)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_jwt_secret_key_here
REFRESH_SECRET=your_very_long_random_refresh_secret_key_here

# AI Services (Self-hosted Ollama) — always the final fallback
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ArvanCloud AI (Optional — Iranian hosted models, OpenAI-compatible API)
# Priority chain: ArvanCloud (if set) → OpenAI (if set) → Ollama (local fallback)
# Uncomment and set these to enable ArvanCloud as the primary AI provider
# ARVANCLOUD_API_KEY=your_arvancloud_api_key_here
# ARVANCLOUD_BASE_URL=https://api.arvancloud.ir/aiapi/v1
# ARVANCLOUD_MODEL=qwen2.5

# OpenAI (Optional — international fallback)
# OPENAI_API_KEY=your_openai_api_key_here

# Iranian SMS Service (Kavenegar)
KAVENEGAR_API_KEY=your_kavenegar_api_key_here

# Iranian Payment Gateway (Shetab)
SHETAB_MERCHANT_ID=your_merchant_id
SHETAB_TERMINAL_ID=your_terminal_id
SHETAB_API_KEY=your_shetab_api_key
SHETAB_GATEWAY_URL=https://sep.shaparak.ir/payment.aspx
# IMPORTANT: The path must be exactly /api/payments/shetab/callback
SHETAB_CALLBACK_URL=https://yourdomain.com/api/payments/shetab/callback

# VoIP Configuration (Isabel / Issabel PBX)
# AMI (Asterisk Manager Interface) uses port 5038 — NOT SIP port 5060
ISABEL_VOIP_ENABLED=false
ISABEL_VOIP_SERVER=your_issabel_server_ip
ISABEL_VOIP_PORT=5038
ISABEL_VOIP_USERNAME=your_ami_username
ISABEL_VOIP_PASSWORD=your_ami_secret
ISABEL_VOIP_RECORDING_ENABLED=true
ISABEL_VOIP_RECORDING_PATH=./recordings

# WebRTC/TURN Server (Self-hosted)
TURN_SERVER_URL=turn:yourdomain.com:3478
TURN_SERVER_USERNAME=turnuser
TURN_SERVER_PASSWORD=turnpassword
STUN_SERVER_URL=stun:yourdomain.com:3478

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,docx,mp4,webm

# Session Configuration
SESSION_SECRET=your_session_secret_here
SESSION_TIMEOUT=86400000

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Meta Lingua <noreply@yourdomain.com>

# Security Settings
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_DIR=/app/logs

# Backup Settings
BACKUP_DIR=/backup
BACKUP_RETENTION_DAYS=30

# Performance
WORKER_THREADS=4
MAX_CONNECTIONS=100

# Feature Flags
ENABLE_CALLERN=true
ENABLE_VIDEO_RECORDING=true
ENABLE_AI_SUPERVISOR=true
ENABLE_GAMIFICATION=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_PAYMENT_GATEWAY=true

# Development Only (Remove in production)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
